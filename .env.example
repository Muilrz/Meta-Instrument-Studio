# 复制为 .env 后填写。.env 已被 .gitignore 排除，真实密钥不要提交。
# P0 阶段不需要任何密钥；以下变量名为后续阶段预留。

# LLM 供应商（P2 起，见待决策事项 D2）
LLM_PROVIDER=
LLM_API_KEY=

# Project Service 数据库（P1 起）：PostgreSQL 17 + pgvector，本地由 compose.yaml 启动
MIS_DATABASE_URL=postgresql+psycopg://mis:mis@localhost:5432/mis
# 测试专用数据库，测试会在其中建表并回滚
MIS_TEST_DATABASE_URL=postgresql+psycopg://mis:mis@localhost:5432/mis_test
