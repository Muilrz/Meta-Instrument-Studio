# 复制为 .env 后填写。.env 已被 .gitignore 排除；连接地址带密码，不要提交，也不要发到聊天里。

# LLM 供应商（P2 起，见待决策事项 D2）
LLM_PROVIDER=
LLM_API_KEY=

# 开发数据库：Neon（组织 Muil，项目 meta-instrument-studio，新加坡），见 ADR-0001“部署”。
# 在 Neon 控制台 Connect 中复制直连地址（不要选 Pooled），把开头的 postgresql:// 改成 postgresql+psycopg://
MIS_DATABASE_URL=postgresql+psycopg://<用户名>:<密码>@<ep-xxxx>.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 测试数据库：Neon 上 test 分支的直连地址（P1 的 T5 创建该分支后填写），测试会在其中建表并回滚
MIS_TEST_DATABASE_URL=

# 能安装 Docker 的开发者可改用本地容器（compose.yaml，P1 的 T5 提供）：
# MIS_POSTGRES_PASSWORD=<本地容器密码>
# MIS_DATABASE_URL=postgresql+psycopg://postgres:<本地容器密码>@localhost:5432/mis
# MIS_TEST_DATABASE_URL=postgresql+psycopg://postgres:<本地容器密码>@localhost:5432/mis_test
