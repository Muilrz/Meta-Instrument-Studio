        "target_currency": {
          "const": "CNY",
          "default": "CNY",
          "title": "Target Currency",
          "type": "string"
        },
        "rate": {
          "exclusiveMinimum": 0,
          "title": "Rate",
          "type": "number"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        }
      },
      "required": [
        "source_currency",
        "rate",
        "as_of"
      ],
      "title": "FxRate",
      "type": "object"
    },
    "InstrumentPlan": {
