          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "page_or_anchor": {
          "minLength": 1,
          "title": "Page Or Anchor",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "source_version": {
          "minLength": 1,
          "title": "Source Version",
          "type": "string"
        },
        "retrieved_by": {
          "$ref": "#/$defs/RunRef"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
