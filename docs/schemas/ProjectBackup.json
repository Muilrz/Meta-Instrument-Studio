        "subject",
        "claim_refs"
      ],
      "title": "BomEntry",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "claim_ids"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "known": "#/$defs/Known",
              "unknown": "#/$defs/Unknown"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Known"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "statement",
        "subject",
        "metric",
        "value"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
