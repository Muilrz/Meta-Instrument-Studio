{
  "$defs": {
    "AgentArtifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Project Id",
          "type": "string"
        },
        "brief_id": {
          "pattern": "^brf_[0-9A-HJKMNP-TV-Z]{26}$",
          "title": "Brief Id",
          "type": "string"
        },
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "requirement_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Requirement Refs",
          "type": "array"
        },
        "candidates": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "open_questions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "produced_by": {
          "$ref": "#/$defs/RunRef"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "accepted",
            "rejected",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "status_history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StatusChange"
          },
          "title": "Status History",
          "type": "array"
        }
      },
      "required": [
        "project_id",
        "brief_id",
        "artifact_type",
        "requirement_refs",
        "claims",
        "produced_by"
      ],
      "title": "AgentArtifact",
      "type": "object"
    },
    "AgentTaskBrief": {
