{
  "$defs": {
    "Known": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "known",
          "default": "known",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "$ref": "#/$defs/QuantityRange"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence_ids"
      ],
      "title": "Known",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "QuantityRange": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "lower",
        "upper",
        "unit"
      ],
      "title": "QuantityRange",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "default": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Project Id",
      "type": "string"
    },
    "requirement_key": {
      "minLength": 1,
      "title": "Requirement Key",
      "type": "string"
    },
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "measured": {
      "discriminator": {
        "mapping": {
          "known": "#/$defs/Known",
          "unknown": "#/$defs/Unknown"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Known"
        },
        {
          "$ref": "#/$defs/Unknown"
        }
      ],
      "title": "Measured"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "unknown"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^evd_[0-9A-HJKMNP-TV-Z]{26}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "requirement_key",
    "plan_version",
    "measured",
    "verdict",
    "evidence_ids"
  ],
  "title": "TestResult",
  "type": "object"
}
