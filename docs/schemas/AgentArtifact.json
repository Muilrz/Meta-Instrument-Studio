{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Ids",
          "type": "array"
        }
      },
      "required": [
        "subject",
        "claim_ids"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "known": "#/$defs/Known",
              "unknown": "#/$defs/Unknown"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Known"
            },
            {
              "$ref": "#/$defs/Unknown"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "statement",
        "subject",
        "metric",
        "value"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Known": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "known",
          "default": "known",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "$ref": "#/$defs/QuantityRange"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "evidence_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "value",
        "evidence_ids"
      ],
      "title": "Known",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "QuantityRange": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "lower",
        "upper",
        "unit"
      ],
      "title": "QuantityRange",
      "type": "object"
    },
    "RunRef": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "trace_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "actor": {
          "enum": [
            "copilot",
            "lab",
            "research",
            "procurement",
            "rule_engine",
            "user"
          ],
          "title": "Actor",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "skill_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Skill Versions",
          "type": "object"
        },
        "prompt_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "run_id",
        "actor"
      ],
      "title": "RunRef",
      "type": "object"
    },
    "StatusChange": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "accepted",
            "rejected",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "trigger_id": {
          "minLength": 1,
          "title": "Trigger Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason",
        "trigger_id"
      ],
      "title": "StatusChange",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "unknown",
          "default": "unknown",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Project Id",
      "type": "string"
    },
    "brief_id": {
      "pattern": "^brf_[0-9A-HJKMNP-TV-Z]{26}$",
      "title": "Brief Id",
      "type": "string"
    },
    "artifact_type": {
      "minLength": 1,
      "title": "Artifact Type",
      "type": "string"
    },
    "requirement_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirement Refs",
      "type": "array"
    },
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "assumptions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "open_questions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "produced_by": {
      "$ref": "#/$defs/RunRef"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "accepted",
        "rejected",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_history": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StatusChange"
      },
      "title": "Status History",
      "type": "array"
    }
  },
  "required": [
    "project_id",
    "brief_id",
    "artifact_type",
    "requirement_refs",
    "claims",
    "produced_by"
  ],
  "title": "AgentArtifact",
  "type": "object"
}
